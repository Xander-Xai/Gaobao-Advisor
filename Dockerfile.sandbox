# Dedicated, disposable synthetic execution runtime.
# Never copy the Gaobao application, data, repository, credentials or tests.
# The trusted runner and fictional source are injected as separate bind mounts
# by the host-only broker in benchmarks/sandbox_workspace.py.
FROM python:3.11-slim

WORKDIR /workspace
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 65534:65534
